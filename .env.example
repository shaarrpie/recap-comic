# manhwa-recap/.env.example — copy to .env and fill in. Never commit .env.
# Xkiro (default AI backend: Qwen3.5-397B-A17B primary + Mistral Medium 3.5
# automatic fallback, OpenAI-compatible endpoint):
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Optional model overrides (provider IDs; bare names like Qwen3.5-397B-A17B
# and Mistral Medium 3.5 are also accepted and resolved automatically):
# XKIRO_PRIMARY_MODEL=qwen/qwen3.5-397b-a17b:free
# XKIRO_FALLBACK_MODEL=mistralai/mistral-medium-3.5
# Gemini (legacy vision backend for narrate + guided Phase 1; also used as
# a fallback key source for the default xkiro/Qwen backend if XKIRO_* is
# unset):
GEMINI_API_KEY=
# Optional: comma-separated list for automatic key rotation on quota errors.
# GEMINI_API_KEYS=key1,key2,key3
# OpenAI vision backend (guided --backend openai):
OPENAI_API_KEY=
# Anthropic vision backend (guided --backend anthropic):
ANTHROPIC_API_KEY=
# Cloudflare Workers AI backend:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Ollama local backend (optional; defaults to http://localhost:11434):
OLLAMA_BASE_URL=
# ComiQ vision model endpoint override (optional; defaults to Google's):
MLLM_API_KEY=
