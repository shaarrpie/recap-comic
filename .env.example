# manhwa-recap/.env.example — copy to .env and fill in. Never commit .env.
# Agnes AI (sole AI provider: agnes-2.5-flash primary + agnes-2.0-flash
# automatic fallback, OpenAI-compatible endpoint):
AGNES_API_KEY=
# Optional: comma-separated key pool for higher throughput — chunks start
# round-robin across keys (each key has its own 20 RPM) and a rate-limited
# key automatically fails over to the next one:
# AGNES_API_KEYS=key1,key2,key3
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# Optional model overrides (Agnes model IDs):
# AGNES_PRIMARY_MODEL=agnes-2.5-flash
# AGNES_FALLBACK_MODEL=agnes-2.0-flash
# Throttle recovery: when all keys hit 429 at once, wait with linear
# backoff and retry the pool instead of failing (free tier recovers by
# waiting a few minutes). Rounds=0 restores fail-immediately.
# AGNES_RATE_WAIT_S=120
# AGNES_RATE_WAIT_ROUNDS=2
# Phase-1 chunk parallelism (each key has its own 20 RPM; keep total
# sustained requests comfortably below keys x 20):
# MANHWA_CHUNK_CONCURRENCY=8
