# manhwa-recap/.env.example — copy to .env and fill in. Never commit .env.
# Z AI (chat.z.ai) cookie-based auth for vision/narration backends:
ZAI_TOKEN=
ZAI_COOKIES=
# Gemini (default vision backend for narrate + guided Phase 1):
GEMINI_API_KEY=
# OpenAI vision backend (guided --backend openai):
OPENAI_API_KEY=
# Anthropic vision backend (guided --backend anthropic):
ANTHROPIC_API_KEY=
# Cloudflare Workers AI backend:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Ollama local backend (optional; defaults to http://localhost:11434):
OLLAMA_BASE_URL=
# ComiQ vision model endpoint override (optional; defaults to Google's):
MLLM_API_KEY=
